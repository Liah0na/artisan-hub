// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  artisan
  admin
  superadmin
}

// Stores both the display URL and the Cloudinary public_id for every
// uploaded image, so the server can delete the underlying asset later
// (product/account deletion, avatar replacement) instead of only ever
// being able to display it.
type CloudinaryAsset {
  url      String
  publicId String
}

model User {
  id                        String           @id @default(auto()) @map("_id") @db.ObjectId
  name                      String
  email                     String           @unique
  passwordHash              String
  role                      Role             @default(artisan)
  avatar                    CloudinaryAsset?
  bio                       String?
  phone                     String?
  instagram                 String?
  location                  String?
  products                  Product[]
  emailVerified             Boolean          @default(false)
  verificationToken         String?
  verificationTokenExpires  DateTime?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  @@index([verificationToken])
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Retention policy (see docs/data-retention-and-deletion.md):
  //   - retentionHold: true  → never auto-purged, regardless of age/read.
  //     Set by an admin (e.g. legal/dispute hold) via /admin/messages.
  //   - otherwise: read messages are purged after
  //     CONTACT_MESSAGE_RETENTION_DAYS (default 180d); unread messages
  //     after CONTACT_MESSAGE_RETENTION_DAYS_UNREAD (default 30d).
  // Enforced by lib/services/contact-message-retention.ts, run daily via
  // /api/cron/purge-contact-messages (Vercel Cron) and also available as
  // `npm run purge:messages` for manual/other-host runs.
  //
  // Default is `false`, but queries filter with `retentionHold: { not:
  // true }` rather than `retentionHold: false` — MongoDB documents written
  // before this field existed don't have it stored at all, and `{ not:
  // true }` correctly treats "missing" the same as "false" (unheld),
  // whereas an equality filter would incorrectly exclude them.
  retentionHold Boolean @default(false)

  @@index([read, createdAt])
}

enum ProductStatus {
  pending
  approved
  rejected
}

model Product {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  artisanId       String            @db.ObjectId
  artisan         User              @relation(fields: [artisanId], references: [id])
  name            String
  description     String
  images          CloudinaryAsset[]
  price           Float
  stock           Int               @default(0)
  // Moderation: defaults to "approved" so existing documents created before
  // this field existed (which don't have it stored in MongoDB) keep
  // displaying normally. New products are always created with an explicit
  // "pending" status in the API route — the schema default here only
  // covers legacy/missing data, it is never relied on for new writes.
  status          ProductStatus     @default(approved)
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([artisanId])
  @@index([status])
}
